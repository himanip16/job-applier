# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://ja:ja@localhost:5432/job_applier?schema=public"

# --- Anthropic ------------------------------------------------------------
# Used for cover letters, answer inference and generic-form understanding.
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"

# --- Browser --------------------------------------------------------------
# HEADLESS=false is strongly recommended. A visible, persistent browser
# profile passes invisible reCAPTCHA far more often than a headless one, and
# it is the only way you can take over when a challenge does appear.
HEADLESS=false
# Persistent Chromium profile. Keeps cookies/history so you look like a
# returning human rather than a fresh bot on every run.
BROWSER_PROFILE_DIR=".playwright-profile"
# Slow down interactions to human speed (ms between actions).
ACTION_DELAY_MS=120

# --- Safety ---------------------------------------------------------------
# When true (default) every application stops at REVIEW and waits for you to
# press Submit. Set false only once you trust it.
REQUIRE_REVIEW=true
# Hard cap on unattended submissions per hour. Protects you from spraying.
MAX_SUBMITS_PER_HOUR=10
# Below this the resolver refuses to guess and asks you instead.
ANSWER_CONFIDENCE_THRESHOLD=0.82
# Above this similarity a previously-given answer is reused automatically.
MEMORY_REUSE_THRESHOLD=0.86

# --- Server ---------------------------------------------------------------
PORT=8787
STORAGE_DIR="./storage"

# Use a Chromium already on disk instead of Playwright's download. Leave unset
# unless `npx playwright install chromium` cannot run in your environment.
# CHROMIUM_EXECUTABLE_PATH="/opt/pw-browsers/chromium"

# Destructive integration tests refuse to run unless this points at a database
# whose name ends in _test.
TEST_DATABASE_URL="postgresql://ja:ja@localhost:5432/job_applier_test?schema=public"

# --- Model choice and cost ------------------------------------------------
# ANTHROPIC_MODEL writes what goes out under your name: cover letters, essay
# answers, the resume rewrite, and the grounded/unsupported keyword analysis.
# ANTHROPIC_MODEL_CHEAP handles the high-volume judgement calls - "can this
# question be answered from the resume?", "does this posting fit?" - which run
# many times per application and do not need the top model.
#
# Set both to the same value to opt out of the split.
#   cheapest:  ANTHROPIC_MODEL=claude-sonnet-5  ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
#   default:   ANTHROPIC_MODEL=claude-opus-5    ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
ANTHROPIC_MODEL_CHEAP="claude-haiku-4-5"
