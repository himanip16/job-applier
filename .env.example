# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://ja:ja@localhost:5432/job_applier?schema=public"

# --- Job search -----------------------------------------------------------
# Firecrawl is what lets the app find openings without being told which
# companies to look at. Get a key at https://firecrawl.dev - the free tier is
# enough for a personal job hunt, since one search run costs roughly a dozen
# credits and most of the work is done afterwards by the job boards' own free
# APIs.
#
# Optional. Without it you can still add companies by hand and crawl those,
# paste a job URL directly, and use everything else.
#
#   Worth knowing: your search queries are derived from your resume and go to
#   Firecrawl, which forwards them to a web search provider. The resume itself
#   is never sent.
FIRECRAWL_API_KEY=""
# How many searches per run, and how many results each asks for. Each query
# costs about two credits.
JOB_SEARCH_QUERIES="6"
JOB_SEARCH_RESULTS_PER_QUERY="10"

# --- Model provider -------------------------------------------------------
# Pick one. Leave LLM_PROVIDER unset and it infers from whichever key is set
# (Gemini wins if both are).
#
# Gemini has a genuinely free tier, which is the cheapest way to run this.
# Get a key at https://aistudio.google.com/apikey
#   Caveat worth knowing: on the FREE tier Google may use your API data to
#   improve their products. This app sends your resume and your answers. If
#   that matters to you, enable billing on the Google Cloud project (paid-tier
#   data is excluded) or use Anthropic instead.
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""

# Anthropic is pay-as-you-go from the first token. A Claude.ai Pro or Max
# subscription does NOT include API credits - this is a separate product.
# https://console.anthropic.com
ANTHROPIC_API_KEY=""

# --- Browser --------------------------------------------------------------
# HEADLESS=false is strongly recommended. A visible, persistent browser
# profile passes invisible reCAPTCHA far more often than a headless one, and
# it is the only way you can take over when a challenge does appear.
HEADLESS=false
# Persistent Chromium profile. Keeps cookies/history so you look like a
# returning human rather than a fresh bot on every run.
BROWSER_PROFILE_DIR=".playwright-profile"
# Slow down interactions to human speed (ms between actions).
ACTION_DELAY_MS=120

# --- Safety ---------------------------------------------------------------
# When true (default) every application stops at REVIEW and waits for you to
# press Submit. Set false only once you trust it.
REQUIRE_REVIEW=true
# Hard cap on unattended submissions per hour. Protects you from spraying.
MAX_SUBMITS_PER_HOUR=10
# Below this the resolver refuses to guess and asks you instead.
ANSWER_CONFIDENCE_THRESHOLD=0.82
# Above this similarity a previously-given answer is reused automatically.
MEMORY_REUSE_THRESHOLD=0.86

# --- Server ---------------------------------------------------------------
PORT=8787
STORAGE_DIR="./storage"

# Use a Chromium already on disk instead of Playwright's download. Leave unset
# unless `npx playwright install chromium` cannot run in your environment.
# CHROMIUM_EXECUTABLE_PATH="/opt/pw-browsers/chromium"

# Destructive integration tests refuse to run unless this points at a database
# whose name ends in _test.
TEST_DATABASE_URL="postgresql://ja:ja@localhost:5432/job_applier_test?schema=public"

# --- Model slots ----------------------------------------------------------
# *_MODEL writes what goes out under your name: cover letters, essay answers,
# the resume rewrite, and the grounded-vs-unsupported keyword decision.
# *_MODEL_CHEAP handles the high-volume judgement calls - "can this question be
# answered from the resume?", "does this posting fit?" - which run many times
# per application and do not need the top model.
#
# Set both to the same value to opt out of the split.
#
# Model ids move, especially on Gemini. GET /api/models lists what your key can
# actually reach; the defaults below are only a starting point.
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_MODEL_CHEAP="gemini-3.5-flash"
ANTHROPIC_MODEL="claude-opus-5"
ANTHROPIC_MODEL_CHEAP="claude-haiku-4-5"
