{
  "name": "@ja/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "seed": "tsx src/scripts/seed.ts",
    "apply": "tsx src/scripts/apply.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "DATABASE_URL=\"${TEST_DATABASE_URL:-$DATABASE_URL}\" vitest run",
    "predev": "cd ../.. && prisma generate && (lsof -ti:8787 | xargs kill -9 2>/dev/null || true)",
    "prestart": "cd ../.. && prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "@ja/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "mammoth": "^1.9.0",
    "playwright": "^1.49.1",
    "unpdf": "^0.12.1",
    "zod": "^4.1.13",
    "docx": "^9.1.0",
    "@google/genai": "^2.18.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}