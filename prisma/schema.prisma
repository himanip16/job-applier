// Job Applier — data model
//
// Design notes that matter:
//  * AnswerBank is the long-term memory. Every question a human answers is
//    stored here and reused forever. It is keyed two ways: by a canonical
//    key (when a deterministic rule recognised the question) and by the raw
//    normalised label + embedding (for everything else).
//  * PendingQuestion is what makes a run *block*. A run cannot submit while
//    one is open. That is the whole "pop up and ask" mechanism.
//  * ApplicationEvent is an append-only audit log; the UI replays it.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person who can sign in.
///
/// Kept separate from Profile on purpose. Profile is the candidate dossier -
/// resume text, facts, answers - and it is what every run, lead and
/// application already hangs off. User is only the credential and the session
/// anchor, so signing in never touches the dossier and a future "two resumes,
/// one login" needs no rework of the tables that matter.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// scrypt, as "scrypt$N$r$p$salt$hash". Never the password.
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  profile        Profile?
  sessions       Session[]
  passwordResets PasswordReset[]

  @@map("users")
}

/// One signed-in browser.
///
/// An opaque random token stored server-side rather than a self-describing
/// one, so signing out actually ends the session instead of asking the holder
/// nicely to forget it.
model Session {
  id        String   @id @default(cuid())
  /// The value in the cookie. Random, 32 bytes, base64url.
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
  @@map("sessions")
}

/// A password reset token.
///
/// These are short-lived, single-use tokens sent by email to let a user
/// regain access to their account without knowing their current password.
model PasswordReset {
  id        String    @id @default(cuid())
  /// SHA-256 hash of the random token sent to the user's email.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  /// Set when the token is successfully used, to prevent reuse.
  usedAt    DateTime?

  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE
}

model Profile {
  id          String  @id @default(cuid())
  /// Null only for the single profile that predates sign-in; the adopt script
  /// attaches it to a user on first run.
  userId      String? @unique
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String  @unique
  fullName    String
  firstName   String
  lastName    String
  phone       String?
  // Structured location so adapters can fill city/state/country separately.
  city        String?
  region      String?
  country     String?
  countryCode String? // ISO-2, for phone/country comboboxes
  citizenship String? // Citizenship country for visa sponsorship determination
  currentCTC  String? // Current salary/CTC
  expectedCTC String? // Expected salary/CTC
  yearsOfExperience Float? // Total years of work experience
  // Work mode preferences (nullable = any)
  preferredWorkMode WorkMode?
  // Location preferences (nullable = any location)
  preferredLocation String? // City, region, or "remote"
  // Whether willing to relocate
  willingToRelocate Boolean @default(false)
  linkedin    String?
  github      String?
  website     String?
  portfolio   String?

  // Free-form narrative used to ground cover letters and answer inference.
  summary    String? @db.Text
  // Full plain-text of the resume. Extracted once at upload; the LLM reads
  // this, never the raw PDF bytes.
  resumeText String? @db.Text

  // Extracted keywords from resume for job matching and search
  resumeKeywords Json? // Array of {keyword, weight, category}

  // LinkedIn connection state
  linkedinConnectionStatus LinkedInConnectionStatus @default(NOT_CONNECTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facts         ProfileFact[]
  resumes       ResumeFile[]
  answers       Answer[]
  applications  Application[]
  linkedinSyncs LinkedInSync[]
  conversations LinkedInConversation[]
  outreachItems OutreachItem[]
  companyExclusions CompanyExclusion[]
  applicationBudgets ApplicationBudget[]
  validationResults ValidationResult[]
  autoApplyDecisions AutoApplyDecision[]

  @@map("profiles")
}

/// Atomic, checkable facts about the candidate. The LLM may only answer a
/// form question if the answer is derivable from these + resumeText.
model ProfileFact {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  key       String // e.g. "work_authorization.us"
  label     String // human-readable question this fact answers
  value     String   @db.Text
  kind      FactKind @default(TEXT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, key])
  @@map("profile_facts")
}

enum FactKind {
  TEXT
  BOOLEAN
  NUMBER
  DATE
  ENUM
  LIST
}

model ResumeFile {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  label     String // "Default", "Backend-focused", ...
  filename  String
  mimeType  String
  path      String // on-disk path under storage/resumes
  bytes     Int
  isDefault Boolean  @default(false)
  text      String?  @db.Text
  createdAt DateTime @default(now())

  tailoredResumes TailoredResume[] @relation("TailoredResumeBase")

  @@map("resume_files")
}

/// The persistent answer bank — the thing that makes application #2 faster
/// than application #1.
model Answer {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Canonical key when a rule matched (e.g. "visa.sponsorship_required"),
  /// otherwise null and matching falls back to label similarity.
  canonicalKey    String?
  /// Normalised question text, used for exact-hash and fuzzy matching.
  normalizedLabel String
  /// The exact label as it appeared, for display.
  rawLabel        String  @db.Text
  /// Sparse lexical vector for similarity search, stored as {term: weight}.
  vector          Json

  /// The answer itself. `value` is the canonical machine value; `displayValue`
  /// is what gets typed/selected in a form.
  value        Json
  displayValue String @db.Text

  fieldKind FieldKind
  /// Option set this answer was given against, if any. Reusing an answer
  /// requires the new field's options to be compatible.
  options   Json?

  source     AnswerSource
  confidence Float        @default(1)
  /// PER_COMPANY answers (essays like "why do you want to work here") are
  /// never reused verbatim across companies.
  scope      AnswerScope  @default(GLOBAL)
  companyKey String?

  timesUsed  Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([profileId, canonicalKey])
  @@index([profileId, normalizedLabel])
  @@map("answers")
}

enum AnswerSource {
  USER // a human typed it. Highest trust, never overwritten silently.
  PROFILE // read straight off the structured profile
  INFERRED // LLM derived it from profile/resume with high confidence
}

enum AnswerScope {
  GLOBAL
  PER_COMPANY
}

enum FieldKind {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  URL
  NUMBER
  DATE
  SELECT
  MULTISELECT
  RADIO
  CHECKBOX
  CHECKBOX_GROUP
  FILE
  UNKNOWN
}

model Job {
  id              String   @id @default(cuid())
  url             String   @unique
  ats             String // greenhouse | lever | ashby | workable | generic
  company         String
  title           String
  location        String?
  descriptionText String?  @db.Text
  discoveredAt    DateTime @default(now())

  /// Extracted job metadata
  workMode        WorkMode?
  salaryMin       Int?      // Minimum salary in USD (or null if not specified)
  salaryMax       Int?      // Maximum salary in USD (or null if not specified)
  experienceMin   Float?    // Minimum years of experience required
  experienceMax   Float?    // Maximum years of experience required

  applications    Application[]
  tailoredResumes TailoredResume[] @relation("TailoredResumeJob")
  validationResults ValidationResult[]
  autoApplyDecisions AutoApplyDecision[]
  llmUsage        LLMUsage[] @relation("LLMUsageJob")

  @@map("jobs")
}

model Application {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status        AppStatus @default(QUEUED)
  /// Set when status = NEEDS_INPUT / BLOCKED so the UI can explain itself.
  blockedReason String?   @db.Text
  /// Whether this was a dry-run (simulated without actual submission)
  dryRun        Boolean   @default(false)

  /// Snapshot of every field we discovered plus what we filled. This is the
  /// audit trail — you can prove exactly what was submitted on your behalf.
  fieldPlan        Json?
  /// Whether to write one at all. Off by default: most applications do not
  /// need a cover letter, and generating one for every job spends a model
  /// call and thirty seconds on something nobody reads. A form that *requires*
  /// one still gets one - the run says so in its log.
  writeCoverLetter Boolean @default(false)
  coverLetter      String? @db.Text
  resumeFileId     String?

  requiresReview Boolean   @default(true)
  submittedAt    DateTime?
  confirmation   String?   @db.Text

  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Retry tracking
  lastRetryAt    DateTime?
  retryCount     Int      @default(0)
  /// When to attempt next retry (exponential backoff)
  nextRetryAt    DateTime?
  /// Whether this is in the dead-letter queue (permanently failed)
  deadLettered   Boolean  @default(false)
  deadLetterReason String? @db.Text

  // ---- tracker -----------------------------------------------------------
  /// Where this stands with the employer, as opposed to `status`, which is
  /// where the automation got to. A run can be SUBMITTED and the outcome
  /// REJECTED; they are different facts and conflating them loses both.
  outcome          Outcome         @default(IN_PROGRESS)
  outcomeAt        DateTime?
  outcomeNote      String?         @db.Text
  /// The tailored resume that actually went out, if one did.
  tailoredResumeId String?
  tailoredResume   TailoredResume? @relation("ApplicationTailoredResume", fields: [tailoredResumeId], references: [id], onDelete: SetNull)
  /// Free-form notes: recruiter name, referral, salary discussed.
  notes            String?         @db.Text

  events    ApplicationEvent[]
  pending   PendingQuestion[]
  artifacts Artifact[]
  rounds    InterviewRound[]
  lessons   Lesson[]
  deadLetterRecords DeadLetterRecord[]
  validationResults ValidationResult[]
  autoApplyDecisions AutoApplyDecision[]
  llmUsage LLMUsage[]

  @@unique([profileId, jobId])
  @@index([status])
  @@map("applications")
}

enum AppStatus {
  QUEUED
  PREPARING // fetching page, parsing form, writing cover letter
  FILLING
  NEEDS_INPUT // blocked on a human answering a question
  NEEDS_HUMAN // blocked on captcha / login / email verification
  REVIEW // filled and waiting for the human's go-ahead
  SUBMITTING
  SUBMITTED
  FAILED
  CANCELLED
}

/// An open question the run is blocked on. Answering it writes to Answer.
model PendingQuestion {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// The run-scoped handle the runner addresses this control by.
  fieldId       String
  fieldSelector String
  rawLabel      String    @db.Text
  helpText      String?   @db.Text
  fieldKind     FieldKind
  options       Json?
  required      Boolean   @default(true)

  /// Why we are asking rather than answering: NO_MATCH | LOW_CONFIDENCE | POLICY
  reason              String
  /// The LLM's best guess, shown as a prefill the human can accept or correct.
  suggestion          Json?
  suggestionRationale String? @db.Text

  answeredAt  DateTime?
  answerValue Json?
  /// Whether the human wants this remembered for future applications.
  remember    Boolean   @default(true)

  createdAt DateTime @default(now())

  @@index([applicationId, answeredAt])
  @@map("pending_questions")
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type      String // STATUS | LOG | FIELD_FILLED | QUESTION_ASKED | ...
  message   String   @db.Text
  data      Json?
  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
  @@map("application_events")
}

model Artifact {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  kind      String // screenshot | dom | payload
  label     String
  path      String
  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
  @@map("artifacts")
}

// ---------------------------------------------------------------------------
// Discovery
// ---------------------------------------------------------------------------

/// A company whose board we watch. Most of these have a public, unauthenticated
/// postings API - the boards publish them so aggregators can read them - which
/// is far kinder and far more reliable than scraping the rendered page.
model Company {
  id            String    @id @default(cuid())
  name          String
  /// greenhouse | lever | ashby | workable | careers-page
  source        String
  /// Board slug for API sources, or the careers-page URL for crawling.
  handle        String
  enabled       Boolean   @default(true)
  lastCrawledAt DateTime?
  lastCrawlNote String?   @db.Text
  createdAt     DateTime  @default(now())

  leads JobLead[]

  @@unique([source, handle])
  @@map("companies")
}

/// A discovered posting, before you have decided anything about it.
model JobLead {
  id        String   @id @default(cuid())
  profileId String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  url             String
  ats             String
  title           String
  companyName     String
  location        String?
  remote          Boolean   @default(false)
  descriptionText String?   @db.Text
  postedAt        DateTime?
  /// When the job posting expires/closes (estimated or actual)
  expiresAt       DateTime?

  /// 0-100. Lexical prior blended with the model's read of the description.
  score        Float     @default(0)
  /// Short human-readable reasons behind the score, good and bad.
  scoreReasons Json?
  scoredAt     DateTime?
  /// True once a model has looked at it; false means lexical score only.
  deepScored   Boolean   @default(false)

  status         LeadStatus @default(NEW)
  /// Free-text reason the candidate gave when rejecting. Optional by design -
  /// a forced reason produces noise, and noise trains the scorer badly.
  rejectReason   String?    @db.Text
  /// Coarse bucket the reason maps to, used as a training signal.
  rejectCategory String?
  decidedAt      DateTime?

  /// Set once this lead turns into a real application.
  applicationId String?
  /// Version for optimistic concurrency control when claiming leads
  version        Int       @default(0)

  discoveredAt DateTime @default(now())

  @@unique([profileId, url])
  @@index([profileId, status, score])
  @@index([profileId, status, expiresAt])
  @@map("job_leads")
}

enum LeadStatus {
  NEW
  SHORTLISTED
  REJECTED
  APPLIED
  EXPIRED
}

/// What the candidate's accept/reject history has taught us.
///
/// Kept as explicit, inspectable rows rather than opaque weights: you can read
/// why a job was ranked down, and delete a signal that has gone stale.
model PreferenceSignal {
  id        String @id @default(cuid())
  profileId String

  /// A term, phrase or attribute, e.g. "on-site", "series a", "php".
  term      String
  /// Positive = the candidate leans toward this, negative = away from it.
  weight    Float
  /// LEXICAL (derived from decisions) or STATED (the candidate said so).
  origin    String   @default("LEXICAL")
  /// How many decisions contributed.
  evidence  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([profileId, term])
  @@index([profileId, weight])
  @@map("preference_signals")
}

// ---------------------------------------------------------------------------
// Resume tailoring
// ---------------------------------------------------------------------------

/// A resume rewritten for one specific job.
///
/// The only interesting field is `insertions`: every keyword this version adds
/// that the base resume did not contain, together with the evidence that let
/// us add it. Nothing lands in a tailored resume without a line in there.
model TailoredResume {
  id           String     @id @default(cuid())
  profileId    String
  jobId        String?
  job          Job?       @relation("TailoredResumeJob", fields: [jobId], references: [id], onDelete: SetNull)
  baseResumeId String
  baseResume   ResumeFile @relation("TailoredResumeBase", fields: [baseResumeId], references: [id], onDelete: Cascade)

  label    String
  text     String  @db.Text
  /// Paths to the generated files, relative to the storage dir.
  txtPath  String?
  docxPath String?

  /// [{ keyword, evidence, sourceField }]
  insertions  Json
  /// Keywords the job wants that could NOT be grounded, and so were left out.
  /// Surfaced to the candidate as honest gaps, never written into the resume.
  unsupported Json
  /// [{ keyword, where }] - already present before tailoring.
  covered     Json
  /// 0-100 estimate of keyword coverage against the job description.
  coverage    Float @default(0)

  applications Application[] @relation("ApplicationTailoredResume")

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@map("tailored_resumes")
}

// ---------------------------------------------------------------------------
// Tracker
// ---------------------------------------------------------------------------

enum Outcome {
  IN_PROGRESS
  REJECTED
  GHOSTED
  WITHDRAWN
  OFFER
  ACCEPTED
  DECLINED
}

model InterviewRound {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  name         String // "Recruiter screen", "Technical", "Onsite", ...
  sequence     Int       @default(0)
  scheduledAt  DateTime?
  completedAt  DateTime?
  /// SCHEDULED | PASSED | FAILED | CANCELLED | PENDING_RESULT
  status       String    @default("SCHEDULED")
  interviewers String?
  format       String? // phone, video, onsite, take-home
  notes        String?   @db.Text

  questions InterviewQuestion[]
  lessons   Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId, sequence])
  @@map("interview_rounds")
}

/// A question you were actually asked. Worth recording twice over: it tells you
/// what this company probes for, and the good answers become reusable material.
model InterviewQuestion {
  id      String         @id @default(cuid())
  roundId String
  round   InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  question   String   @db.Text
  myAnswer   String?  @db.Text
  /// How it went, in your own judgement: GOOD | OK | POOR
  selfRating String?
  category   String? // behavioural, system-design, coding, culture, ...
  createdAt  DateTime @default(now())

  @@index([roundId])
  @@map("interview_questions")
}

/// "What I think I got wrong." The most useful table in here after six months.
model Lesson {
  id            String          @id @default(cuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundId       String?
  round         InterviewRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  text      String   @db.Text
  category  String? // preparation, communication, technical, fit, logistics
  createdAt DateTime @default(now())

  @@index([applicationId])
  @@map("lessons")
}

/// Settings you can change from the UI instead of editing .env and restarting.
///
/// API keys live here so the app is usable without a text editor. That is the
/// same trust level as .env - plaintext, readable by anyone who can read the
/// database - and no worse, but no better either. The values are never sent
/// back to the browser once saved; the UI only ever sees a masked preview.
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Application reliability & rate limiting
// ---------------------------------------------------------------------------

/// Transactional outbox for reliable event delivery.
///
/// Events are written here in the same transaction as the state change that
/// produced them, then a background worker reads and delivers them. This
/// guarantees that no event is lost if the process crashes between the state
/// change and the event delivery.
model OutboxEvent {
  id        String   @id @default(cuid())
  /// The event type (e.g., 'application.queued', 'application.submitted')
  eventType String
  /// Event payload as JSON
  payload   Json
  /// Which entity this event is about (for idempotency)
  entityId  String
  /// Entity type (e.g., 'application', 'lead')
  entityType String
  /// When this event was created
  createdAt DateTime @default(now())
  /// When this event was successfully delivered
  deliveredAt DateTime?
  /// Number of delivery attempts
  attempts   Int      @default(0)
  /// Error message from last failed delivery attempt
  lastError  String?  @db.Text
  /// When to attempt next retry (exponential backoff)
  nextRetryAt DateTime?
  /// Whether this event is in the dead-letter queue (permanently failed)
  deadLettered Boolean @default(false)
  /// Reason for dead-lettering
  deadLetterReason String? @db.Text

  @@index([deliveredAt, createdAt])
  @@index([entityId, entityType])
  @@index([nextRetryAt])
  @@index([deadLettered])
  @@map("outbox_events")
}

/// Company exclusion list per profile.
///
/// Companies that the user has opted out of applying to automatically.
model CompanyExclusion {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Normalized company name (lowercased, punctuation stripped)
  companyKey String
  /// Original company name as it appeared
  companyName String
  /// Reason for exclusion
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([profileId, companyKey])
  @@index([profileId, companyKey])
  @@map("company_exclusions")
}

// ---------------------------------------------------------------------------
// LinkedIn outreach
// ---------------------------------------------------------------------------

/// Someone at a company worth talking to alongside the application.
///
/// Scoped to a profile rather than global, because "who I found while looking
/// for work" is part of one person's search and not a shared directory. The
/// unique key is the profile URL, which is the only stable identifier
/// LinkedIn exposes without an API - names collide and headlines change
/// weekly.
model Contact {
  id        String @id @default(cuid())
  profileId String

  fullName    String
  headline    String?     @db.Text
  companyName String
  /// Lowercased, punctuation-stripped company name, so "Mercury," and
  /// "mercury" are one company when grouping messages.
  companyKey  String
  location    String?
  /// Canonicalised to https://www.linkedin.com/in/<slug> - the search results
  /// carry tracking query strings that would otherwise defeat the unique key.
  profileUrl  String
  role        ContactRole
  /// The words that produced the classification, so a wrong one is debuggable
  /// from the UI instead of from the regex.
  roleReason  String?
  /// "1st" | "2nd" | "3rd+", as LinkedIn reports it. This decides whether the
  /// approach is a connection request or a direct message, so it is recorded
  /// rather than guessed at send time.
  degree      String?

  discoveredAt DateTime @default(now())

  // Sync state
  isConnection Boolean   @default(false)
  lastSyncedAt DateTime?

  /// When you decided this conversation is finished.
  ///
  /// Nothing infers this. A thread that has gone quiet is not the same as one
  /// that ended - being ghosted by a recruiter looks identical in the message
  /// history to a polite "we'll keep you in mind", and only you know which it
  /// was. So it is set by an explicit action and never by a timer, which also
  /// makes it reversible: reopening is just clearing the date.
  conversationClosedAt DateTime?

  messages OutreachMessage[]
  conversations LinkedInConversation[]
  outreachItems OutreachItem[]

  @@unique([profileId, profileUrl])
  @@index([profileId, companyKey])
  @@map("contacts")
}

enum ContactRole {
  /// Recruiter, talent acquisition, sourcer, people team.
  TALENT
  /// Engineering manager, director, VP, head of engineering, CTO.
  ENGINEERING
  OTHER
}

/// One drafted approach, waiting for you.
///
/// Nothing in this table is ever sent by a background job. `status` leaves
/// DRAFT only inside a request a human initiated, and the row keeps both what
/// the model wrote (`draftBody`) and what was actually approved (`finalBody`)
/// so the two can be compared after the fact. That separation is the audit
/// trail for anything that went out under your name.
model OutreachMessage {
  id        String @id @default(cuid())
  profileId String

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// The posting this is about. Denormalised on purpose: the lead can be
  /// rejected, expire or be deleted, and a sent message still has to be able
  /// to say what it was about.
  leadId      String?
  jobTitle    String
  jobUrl      String
  companyName String

  channel   OutreachChannel
  /// What the model wrote. Never overwritten by an edit.
  draftBody String          @db.Text
  /// What you approved. Null until you approve it.
  finalBody String?         @db.Text
  /// The channel's hard cap, so the editor can enforce the same number the
  /// send step will.
  charLimit Int

  status       OutreachStatus @default(DRAFT)
  /// Why it is SKIPPED or FAILED. Null otherwise.
  statusReason String?        @db.Text

  /// Whether approving this should also queue the job application. Per-message
  /// rather than a global setting: reaching out about a role you are not ready
  /// to apply to is a normal thing to want.
  alsoApply     Boolean @default(true)
  applicationId String?

  editedAt   DateTime?
  approvedAt DateTime?
  sentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, contactId, jobUrl])
  @@index([profileId, status, createdAt])
  @@map("outreach_messages")
}

enum OutreachChannel {
  /// Invitation with a note. 300 characters, and only for people you are not
  /// already connected to.
  CONNECTION_NOTE
  /// Already connected, so the message box is open.
  DIRECT_MESSAGE
  /// Costs a credit. Drafted, never sent automatically.
  INMAIL
}

enum OutreachStatus {
  DRAFT
  APPROVED
  SENDING
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// LinkedIn sync
// ---------------------------------------------------------------------------

model LinkedInSync {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  syncType   SyncType
  lastSyncAt DateTime?
  status     SyncStatus @default(PENDING)
  error      String?    @db.Text

  // Heartbeat mechanism to detect stuck syncs
  startedAt   DateTime?
  heartbeatAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, syncType])
  @@map("linkedin_sync")
}

enum SyncType {
  CONNECTIONS
  MESSAGES
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT // When heartbeat expires for stuck syncs
}

enum LinkedInConnectionStatus {
  NOT_CONNECTED
  WAITING_FOR_SIGN_IN
  CONNECTED
  CHALLENGE_REQUIRED
  REAUTH_REQUIRED // When user needs to manually re-authenticate
}

model LinkedInConversation {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  linkedinConversationId String
  linkedinProfileUrl     String

  lastMessageAt DateTime?
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages      LinkedInMessage[]
  outreachItems OutreachItem[]

  @@unique([profileId, linkedinConversationId])
  @@index([profileId, lastMessageAt])
  @@index([contactId])
  @@map("linkedin_conversations")
}

model LinkedInMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   LinkedInConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  linkedinMessageId String
  senderProfileUrl  String
  isFromMe          Boolean
  body              String   @db.Text
  sentAt            DateTime

  createdAt DateTime @default(now())

  @@unique([conversationId, linkedinMessageId])
  @@index([conversationId, sentAt])
  @@map("linkedin_messages")
}

// ---------------------------------------------------------------------------
// Outreach queue (unified cold/reply/follow-up)
// ---------------------------------------------------------------------------

model OutreachItem {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  type OutreachType

  leadId      String?
  jobTitle    String?
  jobUrl      String? @default("") // Uses empty string as default to avoid NULL unique constraint bug
  companyName String?

  channel   OutreachChannel
  draftBody String          @db.Text
  finalBody String?         @db.Text
  charLimit Int

  status       OutreachStatus @default(DRAFT)
  statusReason String?        @db.Text

  conversationId String?
  conversation   LinkedInConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  lastMessages   Json?

  editedAt   DateTime?
  approvedAt DateTime?
  sentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, contactId, type, jobUrl])
  @@index([profileId, status, type, createdAt])
  @@index([contactId])
  @@map("outreach_items")
}

enum OutreachType {
  COLD
  REPLY
  FOLLOW_UP
}

// ---------------------------------------------------------------------------
// Distributed locking
// ---------------------------------------------------------------------------

/// Database-backed lease for distributed locks with expiration.
///
/// This table provides lease expiration and stale-lock recovery for distributed
/// locks. Works in combination with PostgreSQL advisory locks for fast acquisition
/// and reliable crash handling.
model SchedulerLease {
  id           String   @id @default(cuid())
  /// Lease key (e.g., 'job-discovery' for the scheduler)
  leaseKey     String   @unique
  /// Instance identifier (hostname:pid) to track which instance holds the lease
  instanceId   String
  /// When the lease was acquired
  acquiredAt   DateTime @default(now())
  /// When the lease expires (must be refreshed via heartbeat)
  expiresAt    DateTime
  /// Last heartbeat timestamp
  heartbeatAt  DateTime @default(now())
  /// Lease status
  status       LeaseStatus @default(ACTIVE)

  @@index([leaseKey, status])
  @@index([expiresAt])
  @@map("scheduler_leases")
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  RELEASED
}

// ---------------------------------------------------------------------------
// Dead-Letter Queue (DLQ) for failed applications
// ---------------------------------------------------------------------------

/// Detailed failure attempt records for the dead-letter queue.
///
/// Each failed application gets one or more DLQ records documenting every
/// failure attempt. This enables inspection, filtering, and manual retry
/// with full attempt history.
model DeadLetterRecord {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// When this failure occurred
  failedAt DateTime @default(now())
  /// Error type/category (e.g., 'NETWORK_ERROR', 'CAPTCHA', 'ATS_TIMEOUT')
  errorType String
  /// Detailed error message
  errorMessage String @db.Text
  /// Stack trace if available
  stackTrace String? @db.Text
  /// Application status at time of failure
  statusAtFailure AppStatus
  /// Additional context about the failure (e.g., step in the process)
  failureContext Json?
  /// Whether this record has been retried
  retried Boolean @default(false)
  /// When this record was retried
  retriedAt DateTime?
  /// Result of retry (SUCCESS, FAILED, SKIPPED)
  retryResult String?
  /// Error message from retry attempt
  retryError String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId, failedAt])
  @@index([errorType])
  @@index([retried])
  @@map("dead_letter_records")
}

// ---------------------------------------------------------------------------
// Application budget & rate limiting
// ---------------------------------------------------------------------------

/// Application budget tracking per profile.
///
/// Tracks application counts and limits over different time windows (daily, weekly, monthly).
/// Prevents exceeding configured application limits.
model ApplicationBudget {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Budget window: DAILY | WEEKLY | MONTHLY
  window      BudgetWindow
  /// The start of the current budget window
  windowStart DateTime
  /// The end of the current budget window
  windowEnd   DateTime
  /// Number of applications submitted in this window
  count       Int      @default(0)
  /// Configured limit for this window (null = no limit)
  limit       Int?
  /// When this budget record was last updated
  updatedAt   DateTime @updatedAt

  @@unique([profileId, window, windowStart])
  @@index([profileId, window, windowStart])
  @@index([profileId, window, windowEnd])
  @@map("application_budgets")
}

enum BudgetWindow {
  DAILY
  WEEKLY
  MONTHLY
}

/// Validation results for job applications.
///
/// Records every validation check performed before an application is created or submitted.
/// Provides a complete audit trail of why an application was allowed or blocked.
model ValidationResult {
  id            String      @id @default(cuid())
  profileId     String
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// The job being validated (if applicable)
  jobId         String?
  job           Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// The lead being validated (if applicable)
  leadId        String?

  /// The application being validated (if applicable)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  /// The validation category: LOCATION | SALARY | EXPERIENCE | BUDGET | DUPLICATE | COMPANY_BLACKLIST
  category      ValidationCategory
  /// Whether this validation passed
  passed        Boolean
  /// The reason for the result
  reason        String      @db.Text
  /// Additional context (JSON)
  context       Json?
  /// When this validation was performed
  createdAt     DateTime    @default(now())

  @@index([profileId, createdAt])
  @@index([applicationId, category])
  @@index([leadId, category])
  @@index([createdAt])
  @@map("validation_results")
}

enum ValidationCategory {
  LOCATION
  SALARY
  EXPERIENCE
  BUDGET
  DUPLICATE
  COMPANY_BLACKLIST
  JOB_EXPIRY
  PROFILE_COMPLETENESS
}

/// Auto-apply decision audit log.
///
/// Records every automatic application decision made by the scheduler or auto-apply logic.
/// Critical for understanding why jobs were auto-applied to or skipped.
model AutoApplyDecision {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// The lead that was considered for auto-apply
  leadId    String?
  /// The job being applied to
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// The application that was created (if approved)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  /// Whether auto-apply was approved
  approved  Boolean
  /// The job score
  score     Float?
  /// The decision reason
  reason    String   @db.Text
  /// Any validation failures that blocked this
  failures  Json?    // Array of {category, reason}
  /// Source of the auto-apply: SCHEDULER | BULK_APPLY | API
  source    String   @default("SCHEDULER")
  /// Whether this was a dry-run (simulated without actual application)
  dryRun    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([leadId])
  @@index([applicationId])
  @@index([approved, createdAt])
  @@map("auto_apply_decisions")
}

/// LLM token usage and cost tracking.
///
/// Tracks all LLM API calls with token counts and estimated costs.
/// Enables cost monitoring and budgeting for AI usage.
model LLMUsage {
  id        String   @id @default(cuid())
  profileId String?

  /// The LLM provider: anthropic | gemini
  provider  String
  /// The model used
  model     String
  /// The operation that triggered the call: RESOLVE_FIELD | GENERATE_COVER_LETTER | SCORE_JOB | TAILOR_RESUME
  operation String

  /// Associated application (if applicable)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  /// Associated job (if applicable)
  jobId String?
  job           Job? @relation("LLMUsageJob", fields: [jobId], references: [id], onDelete: SetNull)

  /// Associated lead (if applicable)
  leadId String?

  /// Token counts
  inputTokens     Int
  outputTokens    Int
  totalTokens     Int

  /// Estimated cost in USD
  estimatedCost   Float

  /// The request ID (for debugging)
  requestId String?

  /// When this call was made
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([applicationId])
  @@index([provider, model])
  @@index([createdAt])
  @@map("llm_usage")
}

/// Global emergency kill switch.
///
/// When enabled, prevents all new applications from being created or started.
/// Allows immediate halt of auto-apply operations in case of issues.
model EmergencyKillSwitch {
  id        String   @id @default(cuid())
  /// Whether the kill switch is currently active
  enabled   Boolean  @default(false)
  /// Who enabled it (user ID or 'SYSTEM')
  enabledBy String?
  /// When it was enabled
  enabledAt DateTime?
  /// Reason for enabling
  reason    String?  @db.Text
  /// When it was last updated
  updatedAt DateTime @updatedAt

  @@map("emergency_kill_switch")
}

// ---------------------------------------------------------------------------
// Job discovery rate limiting & source health
// ---------------------------------------------------------------------------

/// Per-source health tracking for job discovery.
///
/// Tracks success/failure rates, error patterns, and circuit breaker state
/// for each job discovery source (ATS boards, career sites, etc.).
model SourceHealth {
  id        String   @id @default(cuid())
  /// Source identifier (e.g., 'greenhouse', 'lever', 'workday', 'google')
  sourceId  String   @unique

  /// Circuit breaker state: CLOSED | OPEN | HALF_OPEN
  circuitState     CircuitState @default(CLOSED)
  /// When the circuit breaker opened (if OPEN)
  openedAt         DateTime?
  /// When to attempt recovery (if OPEN)
  nextAttemptAt    DateTime?
  /// Number of consecutive failures that triggered the circuit
  failureCount     Int      @default(0)
  /// Threshold of consecutive failures to open the circuit
  failureThreshold Int      @default(5)
  /// Success count since last failure (for HALF_OPEN recovery)
  successCount     Int      @default(0)
  /// Success count threshold to close the circuit from HALF_OPEN
  successThreshold Int      @default(3)

  /// Total requests made to this source
  totalRequests    Int      @default(0)
  /// Total successful requests
  successfulRequests Int    @default(0)
  /// Total failed requests
  failedRequests   Int      @default(0)
  /// Total requests that hit rate limits (429)
  rateLimitedRequests Int   @default(0)

  /// Average response time in milliseconds
  avgResponseTime  Float?
  /// Response time samples (for calculating average)
  responseTimeSamples Int   @default(0)

  /// Last successful request timestamp
  lastSuccessAt    DateTime?
  /// Last failure timestamp
  lastFailureAt    DateTime?
  /// Last error message
  lastError        String?  @db.Text

  /// When this record was last updated
  updatedAt        DateTime @updatedAt
  /// When this record was created
  createdAt        DateTime @default(now())

  @@index([circuitState])
  @@index([nextAttemptAt])
  @@map("source_health")
}

enum CircuitState {
  CLOSED  /// Normal operation, requests allowed
  OPEN    /// Circuit tripped, requests blocked
  HALF_OPEN /// Testing recovery, limited requests allowed
}

/// Rate limit tracking using token bucket algorithm.
///
/// Tracks request quotas per source to respect API limits and prevent blocking.
model RateLimitBucket {
  id        String   @id @default(cuid())
  /// Source identifier
  sourceId  String
  /// Rate limit type: REQUESTS_PER_MINUTE | REQUESTS_PER_HOUR | REQUESTS_PER_DAY
  limitType RateLimitType

  /// Maximum tokens (the rate limit)
  maxTokens Int
  /// Current token count
  tokens    Int      @default(0)
  /// When tokens were last refilled
  lastRefillAt DateTime @default(now())
  /// Token refill interval in milliseconds
  refillIntervalMs Int

  /// Timestamp of last request
  lastRequestAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, limitType])
  @@index([sourceId])
  @@map("rate_limit_buckets")
}

enum RateLimitType {
  REQUESTS_PER_MINUTE
  REQUESTS_PER_HOUR
  REQUESTS_PER_DAY
}

/// Job fingerprinting for incremental discovery.
///
/// Tracks discovered jobs by their content hash to avoid re-processing
/// unchanged jobs and support incremental discovery.
model JobFingerprint {
  id        String   @id @default(cuid())
  /// Stable job identifier (URL or unique key from the source)
  jobKey    String   @unique
  /// SHA-256 hash of job content (title + description + location)
  contentHash String
  /// When this job was first discovered
  firstSeenAt DateTime @default(now())
  /// When this job's content last changed
  lastChangedAt DateTime @default(now())
  /// Number of times content has changed
  changeCount Int @default(0)
  /// Previous content hash (if changed)
  previousHash String?

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  @@index([contentHash])
  @@index([lastChangedAt])
  @@map("job_fingerprints")
}
